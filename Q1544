class Solution {
public:
    string makeGood(string s) {
       int i=0;
       while(i<s.length()){
        if(s[i] >= 'A' && s[i] <= 'Z'){
            if( i == 0 &&(s[i]-'A') == (s[i+1] - 'a') ){
                s.erase(i,2);
                i=0;
                
            }
            else if(i==0 && s[i] >= 'A' && s[i] <= 'Z'){
              i++;
            }
            else if( (s[i-1]-'a') == (s[i] - 'A') ){
                s.erase(i-1,2);
                i=0;
                
            }
            else if( (s[i]-'A') == (s[i+1] - 'a') ){
                s.erase(i,2);
                i=0;
                
            }
            else{
                i++;
            }
            
            
        }else{
           i++;
        }
       }
       return s;
    }
};
